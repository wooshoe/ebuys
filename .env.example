# Copy to .env.local for local dev. Production values go in Vercel's
# Environment Variables — never commit real keys. See README for details.

# Required
ANTHROPIC_API_KEY=
APP_SECRET=

# eBay posting
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
SESSION_SECRET=
APP_URL=

# Optional
EBAY_LOCATION_POSTAL_CODE=
EBAY_DEFAULT_PACKAGE_WEIGHT_OZ=
EBAY_STRICT_QUALITY=
PRICE_MARKUP_PERCENT=

# Optional: card-specific pricing for sports/trading cards
# (https://www.pricecharting.com/api-documentation). Unset = cards use the
# active-listing market check, flagged low-confidence.
PRICECHARTING_API_TOKEN=
